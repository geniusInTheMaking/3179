
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Book discovery methods reported by Australians aged 15+ in the 2025 National Arts Participation Survey. Multiple responses allowed.",
    "width": 960,
    "height": 490,
    "background": null,
    "padding": 12,
  
    "data": {
      "url": "data/book_discovery.csv",
      "format": {
        "type": "csv"
      }
    },
  
    "transform": [
      {
        "calculate": "datum.Percentage + '%'",
        "as": "PercentLabel"
      }
    ],
  
    "encoding": {
      "x": {
        "field": "X",
        "type": "quantitative",
        "scale": {
          "domain": [0, 1000]
        },
        "axis": null
      },
      "y": {
        "field": "Y",
        "type": "quantitative",
        "scale": {
          "domain": [0, 490],
          "reverse": true
        },
        "axis": null
      }
    },
  
    "layer": [
      {
        "mark": {
          "type": "circle",
          "opacity": 0.95,
          "stroke": "#FFFFFF",
          "strokeWidth": 2
        },
        "encoding": {
          "size": {
            "field": "Percentage",
            "type": "quantitative",
            "scale": {
              "type": "linear",
              "domain": [0, 39],
              "range": [0, 31000]
            },
            "legend": null
          },
          "color": {
            "field": "Method",
            "type": "nominal",
            "scale": {
              "range": [
                "#00A6A6",
                "#F2B134",
                "#537FE7",
                "#8B5CF6",
                "#35B779",
                "#F28C38",
                "#23B5D3",
                "#A3C644",
                "#D68CE0",
                "#3979A8",
                "#D4A62A"
              ]
            },
            "legend": {
              "title": "Discovery Methods",
              "orient": "right",
              "direction": "vertical",
              "labelFont": "Arial",
              "labelFontSize": 14,
              "labelColor": "#333333",
              "titleFont": "Arial",
              "titleFontSize": 16,
              "titleFontWeight": "bold",
              "titleColor": "#333333",
              "symbolType": "circle",
              "symbolSize": 220,
              "padding": 15,
              "offset": 25,
              "labelLimit": 200
            }
          },
          "tooltip": [
            {
              "field": "Method",
              "type": "nominal",
              "title": "Discovery method"
            },
            {
              "field": "Percentage",
              "type": "quantitative",
              "title": "Respondents (%)",
              "format": ".0f"
            }
          ]
        }
      },
  
      {
        "mark": {
          "type": "text",
          "font": "Arial",
          "fontWeight": "bold",
          "fontSize": 18,
          "color": "#FFFFFF",
          "align": "center",
          "baseline": "middle"
        },
        "encoding": {
          "text": {
            "field": "PercentLabel",
            "type": "nominal"
          }
        }
      }
    ],
  
    "config": {
      "view": {
        "stroke": null
      },
      "axis": {
        "grid": false
      },
      "legend": {
        "labelFont": "Arial",
        "titleFont": "Arial"
      }
    }
  }
  