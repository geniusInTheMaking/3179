
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,

  "width": 430,
  "height": 530,

  "padding": {
    "left": 45,
    "right": 0,
    "top": 5,
    "bottom": 5
  },

  "data": {
    "url": "../data/qld_lga.json",
    "format": {
      "type": "topojson",
      "feature": "Local_Government_Areas"
    }
  },

  "transform": [
    {
      "calculate": "datum.properties.lga == 'Moreton Bay City' ? 'Moreton Bay Regional Council' : datum.properties.lga == 'Southern Downs Regional' ? 'Southern Downs Regioinal Council' : datum.properties.lga == 'Weipa Town' ? 'Weipa Town Authority' : datum.properties.lga + ' Council'",
      "as": "CouncilMatch"
    },
    {
      "lookup": "CouncilMatch",
      "from": {
        "data": {
          "url": "../data/council-data-2024-2025-queensland-public-libraries-annual-statistics.csv"
        },
        "key": "COUNCIL",
        "fields": [
          "USAGE TOTAL PHYSICAL ITEMS",
          "USAGE DIGITAL / ELECTRONIC COLLECTION USAGE",
          "USAGE TOTAL CIRCULATION"
        ]
      }
    },
    {
      "calculate": "datum['USAGE DIGITAL / ELECTRONIC COLLECTION USAGE'] / datum['USAGE TOTAL CIRCULATION'] * 100",
      "as": "DigitalShare"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.7
  },

  "encoding": {
    "color": {
      "field": "DigitalShare",
      "type": "quantitative",
      "title": "Digital share (%)",
      "scale": {
        "scheme": "blues",
        "domain": [0, 100]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 300,
        "values": [0, 25, 50, 75, 100],
        "labelExpr": "datum.value + '%'"
      }
    },

    "tooltip": [
      {
        "field": "properties.lga",
        "type": "nominal",
        "title": "Council"
      },
      {
        "field": "USAGE TOTAL PHYSICAL ITEMS",
        "type": "quantitative",
        "title": "Physical circulation",
        "format": ","
      },
      {
        "field": "USAGE DIGITAL / ELECTRONIC COLLECTION USAGE",
        "type": "quantitative",
        "title": "Digital circulation",
        "format": ","
      },
      {
        "field": "USAGE TOTAL CIRCULATION",
        "type": "quantitative",
        "title": "Total circulation",
        "format": ","
      },
      {
        "field": "DigitalShare",
        "type": "quantitative",
        "title": "Digital share (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "bold"
    }
  }
}
