
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 700,
  "background": null,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "layer": [
    {
      "data": {
        "url": "data/nsw_lga.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2025_AUST_GDA94"
        }
      },

      "transform": [
        {
          "calculate": "datum.properties.LGA_NAME25 == 'Armidale' ? 'Armidale Regional' : datum.properties.LGA_NAME25 == 'Bayside (NSW)' ? 'Bayside' : datum.properties.LGA_NAME25",
          "as": "CouncilMatch"
        },
        {
          "lookup": "CouncilMatch",
          "from": {
            "data": {
              "url": "data/nsw_circulation_2024_25.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "Council",
            "fields": [
              "Population",
              "Circulation",
              "per capita"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.Circulation)",
          "as": "TotalLoans"
        },
        {
          "calculate": "toNumber(datum['per capita'])",
          "as": "LoansPerResident"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#000000",
        "strokeWidth": 0.8
      },

      "encoding": {
        "tooltip": [
          {
            "field": "CouncilMatch",
            "type": "nominal",
            "title": "Council"
          },
          {
            "field": "TotalLoans",
            "type": "quantitative",
            "title": "Total loans",
            "format": ",.0f"
          },
          {
            "field": "LoansPerResident",
            "type": "quantitative",
            "title": "Loans per resident",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/nsw_lga_points.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2025_AUST_GDA94"
        }
      },

      "transform": [
        {
          "filter": "datum.geometry != null"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "latitude"
        },
        {
          "calculate": "datum.properties.LGA_NAME25 == 'Armidale' ? 'Armidale Regional' : datum.properties.LGA_NAME25 == 'Bayside (NSW)' ? 'Bayside' : datum.properties.LGA_NAME25",
          "as": "CouncilMatch"
        },
        {
          "calculate": "datum.properties.LGA_NAME25",
          "as": "CouncilName"
        },
        {
          "lookup": "CouncilMatch",
          "from": {
            "data": {
              "url": "data/nsw_circulation_2024_25.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "Council",
            "fields": [
              "Population",
              "Circulation",
              "per capita"
            ]
          }
        },
        {
          "filter": "isValid(datum.Circulation)"
        },
        {
          "calculate": "toNumber(datum.Circulation)",
          "as": "TotalLoans"
        },
        {
          "calculate": "toNumber(datum['per capita'])",
          "as": "LoansPerResident"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 0.8
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "TotalLoans",
          "type": "quantitative",
          "title": "Total Loans",
          "scale": {
            "range": [20, 800]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Total Loans",
            "offset": -20,
            "values": [
              100000,
              300000,
              500000,
              700000,
              900000
            ],
            "labelExpr": "datum.value / 1000 + 'k'"
          }
        },

        "color": {
          "field": "LoansPerResident",
          "type": "quantitative",
          "title": "Loans per resident",
          "scale": {
            "range": [
              "#F3D6D9",
              "#D98F96",
              "#B84D59",
              "#8B1E2D",
              "#5C1019"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Loans per resident"
          }
        },

        "tooltip": [
          {
            "field": "CouncilMatch",
            "type": "nominal",
            "title": "Council"
          },
          {
            "field": "Population",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          },
          {
            "field": "TotalLoans",
            "type": "quantitative",
            "title": "Total loans",
            "format": ",.0f"
          },
          {
            "field": "LoansPerResident",
            "type": "quantitative",
            "title": "Loans per resident",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "fill": null,
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "padding": 10
    }
  }
}
